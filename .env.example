# MetaBioTarget Environment Configuration Template
METABOTARGET_ENV=development
LOG_LEVEL=INFO

# Cache Directory (defaults to data/cache)
CACHE_DIR=data/cache

# API Endpoints (All standard public endpoints work without API keys)
UNIPROT_API_URL=https://rest.uniprot.org/uniprotkb
OPENTARGETS_GRAPHQL_URL=https://api.platform.opentargets.org/api/v4/graphql
RCSB_PDB_API_URL=https://data.rcsb.org/rest/v1/core/entry
HPA_API_URL=https://www.proteinatlas.org
